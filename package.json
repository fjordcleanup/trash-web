{
  "name": "@fjordcleanup/trash-web",
  "version": "0.0.0-development",
  "description": "Web application to view and report trash to Fjord CleanUP",
  "homepage": "https://trash.fjordcleanup.org",
  "bugs": {
    "url": "https://github.com/fjordcleanup/trash-web/issues"
  },
  "license": "MIT",
  "author": "Markus Tacker <m@coderbyheart.com> | https://coderbyheart.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fjordcleanup/trash-web.git"
  },
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "node --max_old_space_size=8192 ./node_modules/vite/bin/vite.js build --emptyOutDir",
    "prepare": "husky && case \"$npm_command\" in install|ci) check-node-version --package ;; esac",
    "test": "node --no-warnings --test \"!(node_modules)/**/*.spec.ts\"",
    "test:watch": "node --no-warnings --test --watch \"!(node_modules)/**/*.spec.ts\""
  },
  "dependencies": {
    "@bifravst/from-env": "4.0.1",
    "@coderbyheart/aws-dynamodb-es-cqrs": "1.3.1",
    "@fjordcleanup/trash-proto": "1.2.1",
    "@sinclair/typebox": "0.34.52",
    "@smithy/protocol-http": "5.6.2",
    "@smithy/signature-v4": "5.7.5",
    "@smithy/types": "4.20.0",
    "bootstrap": "5.3.9",
    "classnames": "2.5.1",
    "date-fns": "4.4.0",
    "leaflet": "1.9.4",
    "lucide-preact": "0.577.0",
    "oidc-client-ts": "3.5.0",
    "preact": "10.29.8",
    "preact-router": "4.1.2",
    "proj4": "2.23.0",
    "ulidx": "2.4.1"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "3.1175.0",
    "@aws-sdk/client-cloudfront": "3.1175.0",
    "@babel/plugin-syntax-import-assertions": "7.29.7",
    "@bifravst/cloudformation-helpers": "10.0.3",
    "@coderbyheart/oxlint-config": "1.0.1",
    "@commitlint/config-conventional": "21.2.4",
    "@preact/preset-vite": "2.10.6",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.19.2",
    "chalk": "6.0.1",
    "check-node-version": "4.2.1",
    "commitlint": "21.2.4",
    "glob": "11.1.0",
    "handlebars": "4.7.10",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxfmt --write",
      "oxlint --fix"
    ],
    "*.{md,json,yaml,yml,html,css}": [
      "oxfmt --write"
    ]
  },
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/github",
        {
          "successCommentCondition": false,
          "failTitle": false
        }
      ]
    ]
  },
  "engines": {
    "node": ">=26.13.1 <27",
    "npm": ">=12.2.2 <13"
  }
}
